{
	"name": "hyperdeck-server-connection",
	"version": "0.2.0",
	"description": "Typescript Node.js library for emulating a Blackmagic Hyperdeck",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"license": "MIT",
	"homepage": "https://github.com/mint-dewit/hyperdeck-server-connection#readme",
	"contributors": [
		{
			"name": "Mint de Wit",
			"email": "mint@araminta.dev"
		}
	],
	"files": [
		"/dist",
		"/CHANGELOG.md",
		"/README.md",
		"/LICENSE"
	],
	"scripts": {
		"build": "npx trash dist && npm run build:main",
		"build:main": "tsc -p ./tsconfig.build.json",
		"changelog": "npx sofie-version",
		"release": "npm run lint && npm run changelog",
		"validate:dependencies": "npm audit --groups dependencies && npm run license-validate",
		"validate:dev-dependencies": "npm audit --groups devDependencies",
		"prepare": "husky",
		"lint:raw": "eslint",
		"lint": "npm run lint:raw .",
		"lint-fix": "npm run lint -- --fix",
		"license-validate": "npx sofie-licensecheck"
	},
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"blackmagic",
		"bmd",
		"hyperdeck",
		"video",
		"typescript",
		"javascript",
		"open source"
	],
	"devDependencies": {
		"@sofie-automation/code-standard-preset": "github:mint-dewit/code-standard-preset#v3.0.0-feat-sofie-version-npm",
		"@types/node": "^22.15.3",
		"eslint": "^9.26.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.1",
		"prettier": "^3.5.3",
		"trash-cli": "^6.0.0",
		"typescript": "^5.7.3"
	},
	"prettier": "@sofie-automation/code-standard-preset/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"npm run lint:raw --fix"
		]
	},
	"packageManager": "npm@10.9.2"
}
